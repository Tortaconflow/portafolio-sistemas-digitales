{
  "name": "cidiks-ia-advisor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AI_ENABLED": "true",
    "LOCAL_SIMULATION": "false",
    "ALLOWED_ORIGIN": "https://reilycastro.com",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Chat flotante. Comparado con 12 mensajes reales el 2026-11-22: más preciso que Llama 8B,
    // no reveló el prompt ante inyección y cuesta ~12 neurons por respuesta.
    "CHAT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Responde si Gemma tarda más de 6 s o falla (medido: <1 s casi siempre). "none" lo desactiva.
    "CHAT_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "ai": {
    "binding": "AI"
  },
  // Salud y limpieza del ledger cada hora (ver `scheduled` en src/index.ts).
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "BudgetLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1-prod", "new_sqlite_classes": ["BudgetLedger"] }
  ],
  // Solo guarda las líneas de worker/src/chat-log.ts (categorías, sin texto del visitante).
  // invocation_logs=false evita guardar URL, encabezados e IP de cada petición.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false, "head_sampling_rate": 1 }
  }
}
