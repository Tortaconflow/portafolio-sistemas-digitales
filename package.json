{
  "name": "portafolio-sistemas-digitales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:release": "node --experimental-strip-types scripts/check-release.ts",
    "check:evolution": "node --experimental-strip-types scripts/check-evolution.ts",
    "check:advisor": "node --experimental-strip-types scripts/check-advisor.ts && node --experimental-strip-types scripts/check-advisor-integration.ts",
    "check:hybrid": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
